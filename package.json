{
    "name": "zemingengine",
    "private": true,
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "turbo dev",
        "build": "turbo build",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "turbo typecheck",
        "smoke:session": "node scripts/smoke-session.mjs",
        "clean": "turbo clean"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@vitest/coverage-v8": "^3.2.7",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.9.6",
        "turbo": "^2.9.12",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.65.0"
    },
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "packageManager": "npm@10.9.2"
}
