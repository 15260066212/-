# GEO Docker Deployment Environment Variables

# AI Engine Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Credential Encryption Key (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CREDENTIAL_ENCRYPTION_KEY=

# --- Server Configuration ---
PORT=3000
DATABASE_PATH=/app/data/geo-assistant.db

# --- Harvester Service ---
# Base URL of the cookie harvester service (Playwright + noVNC)
HARVESTER_URL=http://harvester:3003

# --- RPA Engine (Remote Execution) ---
# When set, RPA publishing is delegated to the harvester service over HTTP
# instead of launching a local Playwright browser (which is not installed in
# the geo-app container). The harvester container has Playwright + browsers.
RPA_REMOTE_URL=http://harvester:3003
RPA_HEADLESS=true

# Enable LLMWiki fallback publishing (harvester provides /api/llmwiki/publish)
RPA_LLMWIKI_FALLBACK=true

