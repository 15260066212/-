# ============================================================
# GEO主系统 环境变量配置示例
# 更新日期: 2026-10-09
# 覆盖: OpenAI / DeepSeek / 豆包 / 千问 / Kimi / 混元 / 文心一言
# ============================================================

# === AI引擎主提供商选择 ===
# 选择核心业务使用的AI提供商 (影响 client.ts 中的内容生成/分析功能)
#   openai   - OpenAI GPT (默认)
#   deepseek - DeepSeek 深度求索
#   doubao   - 豆包 (火山方舟/字节跳动)
#   ernie    - 文心一言 (百度千帆)
AI_PROVIDER=openai

# === 全局AI参数 ===
# 全局 max_tokens (各平台未单独配置时使用此值)
AI_MAX_TOKENS=4096

# ============================================================
# 一、OpenAI 配置
# ============================================================
# 获取API Key: https://platform.openai.com/api-keys
# 推荐模型: gpt-4o-mini (性价比) / gpt-4o (高质量)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# 二、DeepSeek 配置 (主AI引擎 + 竞品监测)
# ============================================================
# 获取API Key: https://platform.deepseek.com/
# 当前模型: deepseek-chat (V3系列)
# 新可选: deepseek-flash (V4.1-Flash, CED架构, 更低成本)
# 更新日志: https://api-docs.deepseek.com/updates/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 竞品监测API地址 (带联网搜索)
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MAX_TOKENS=4096

# ============================================================
# 三、豆包配置 (火山方舟) ⭐ 重点关注平台
# ============================================================
# 获取API Key: https://console.volcengine.com/ark
# 推荐模型:
#   - doubao-seed-2-1-pro-260915 (Seed 2.1 Pro, 1M上下文, 生产级推理)
#   - doubao-seed-2-1-lite-260915 (Seed 2.1 Lite, 1M上下文, 更快更省)
# 模型文档: https://docs.volcengine.com/docs/82379/1159178
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-1-pro-260915

# --- 豆包竞品监测配置 (Responses API) ---
# Responses API 模型 (竞品监测使用, 通常与 DOUBAO_MODEL 相同)
DOUBAO_RESPONSES_MODEL=doubao-seed-2-1-pro-260915
# Responses API 地址 (默认从 chat/completions 自动替换为 /responses)
# DOUBAO_RESPONSES_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses

# --- 豆包 Web Search 配置 (信源采集优化) ---
# 是否启用豆包搜索Custom版 (sources=["doubao"])
# 默认: true (豆包搜索提供最佳中文信源覆盖, 60-85%字节系高质量引用)
# 设为 "false" 可关闭联网搜索, 仅使用模型自身知识
DOUBAO_WEB_SEARCH_ENABLED=true
# 时效性控制: 豆包对1-2周内内容权重最高, 1个月后引用率急剧下降
# 可选值: 1d, 1w, 1m, 6m, 1y (默认: 1m)
DOUBAO_SEARCH_TIME_RANGE=1m
# 权威度过滤 (站点权威度分级):
#   1 = 仅L1 非常权威 (gov/央媒/985大学/500强/字节高质量数据源)
#   2 = L1-L2 正常权威 (行业垂直站如同花顺/懂车帝 + 综合平台如B站/澎湃) [推荐]
#   3 = L1-L3 一般权威 (普通网站, 内容来源无法考证)
#   4 = 全部 (包含L4内容农场/SEO灌水站, 不推荐)
# 默认: 2 (过滤内容农场和SEO灌水站)
# 文档: https://www.volcengine.com/docs/87772/2518319
DOUBAO_SEARCH_AUTH_LEVEL=2
# 竞品监测API地址 (Responses API)
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses

# ============================================================
# 四、Kimi 配置 (月之暗面) — 竞品监测
# ============================================================
# 获取API Key: https://platform.kimi.ai/
# 推荐模型: kimi-k3 (旗舰模型, 1M token上下文)
# 注意: moonshot-v1系列已于2026年8月全平台退役, 调用返回404
# 更新日志: https://platform.kimi.ai/docs/platform-changelog
KIMI_API_KEY=
KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_MODEL=kimi-k3
KIMI_MAX_TOKENS=4096

# ============================================================
# 五、通义千问配置 (阿里云百炼) — 竞品监测
# ============================================================
# 获取API Key: https://bailian.console.aliyun.com/
# 当前模型: qwen-turbo (性价比)
# 新可选: qwen3-max (旗舰, 2.4T MoE)
# 文档: https://help.aliyun.com/zh/model-studio/
QIANWEN_API_KEY=
QIANWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QIANWEN_MODEL=qwen-turbo
QIANWEN_MAX_TOKENS=4096

# ============================================================
# 六、腾讯混元配置 — 竞品监测
# ============================================================
# 获取API Key: https://console.cloud.tencent.com/tclm
# 推荐模型: hy3 (GA正式版, 256K上下文, 支持多档思考模式)
# 注意: hy3-preview自2026年7月起自动路由到hy3正式版
# 公告: https://cloud.tencent.com/announce/detail/2384
HUNYUAN_API_KEY=
HUNYUAN_API_URL=https://tokenhub-intl.tencentmaas.com/v1/chat/completions
HUNYUAN_MODEL=hy3
HUNYUAN_MAX_TOKENS=4096

# ============================================================
# 七、文心一言配置 (百度千帆) — 主AI引擎备选
# ============================================================
# 获取API Key: https://console.bce.baidu.com/qianfan/
# 当前模型: ernie-4.0-8k
# 千帆价格: 输入¥0.8/缓存命中¥0.2/输出¥3.2 (元/百万tokens)
ERNIE_API_KEY=
ERNIE_BASE_URL=https://qianfan.baidubce.com/v1
ERNIE_MODEL=ernie-4.0-8k

# ============================================================
# 八、安全与服务配置
# ============================================================

# 凭证加密密钥 (生产环境必填)
# 用于AES-256-GCM加密平台凭证
# 生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# 服务端口
PORT=3010

# --- 认证配置 ---
# 设为 'true' 则所有API请求需携带API Key (生产模式)
AUTH_REQUIRE_API_KEY=false
# 默认管理员API Key (首次运行时自动生成)
# DEFAULT_ADMIN_API_KEY=your-secure-admin-key-here

# --- CORS跨域配置 ---
# 允许的前端来源 (逗号分隔)
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# --- 限流配置 ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- 代理配置 (如需) ---
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
