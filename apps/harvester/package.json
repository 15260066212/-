{
  "name": "@zemingengine/harvester",
  "version": "1.0.0",
  "description": "Cookie harvesting service with Playwright + noVNC",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@zemingengine/account-vault": "file:../../packages/account-vault",
    "@zemingengine/shared": "file:../../packages/shared",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "fingerprint-injector": "^2.1.88",
    "playwright": "^1.40.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "@types/ws": "^8.18.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
