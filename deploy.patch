-    return { name, mentionRate, avgScore: avgCScore, mentions: agg.mentions };
-  });
-
-  const overallScore = Math.min(100, Math.round(
-    brandMentionRate * 0.3 + avgScore * 5 + avgSOV * 0.3 + brandRecommendRate * 0.2
-  ));
-
-  return {
-    platformCount: n,
-    brandMentionRate,
-    brandRecommendRate,
-    avgScore,
-    avgSOV,
-    sentimentDist,
-    dominantSentiment,
-    overallScore,
-    totalCitations,
-    ownedCitations,
-    competitorCitations,
-    competitorSummary,
-    platforms: validResults.map((r) => ({
-      name: r.platformName,
